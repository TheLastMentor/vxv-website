---
const email = "sales@vectorxvolt.com";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Vector X Volt | Specialty Fabrication for Sign Shops</title>

    <meta
      name="description"
      content="Vector X Volt builds unusual sign components for sign shops. Bring us the odd ones."
    />
  </head>

  <body>

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <header class="site-header">
      <a class="brand" href="#top">
        <span class="brand-mark">V×V</span>
        <span class="brand-name">VECTOR X VOLT</span>
      </a>

      <nav>
        <a href="#interesting">The Odd Ones</a>
        <a href="#work">On the Bench</a>
        <a href="#process">Process</a>
        <a href="#contact" class="nav-cta">Send a Drawing</a>
      </nav>
    </header>


    <main id="top">

      <!-- =====================================================
           HERO
           ===================================================== -->

      <section class="hero section">

        <div class="hero-copy">

          <p class="eyebrow hero-enter hero-delay-1">
            HOUSTON · SPECIALTY SIGN FABRICATION
          </p>

          <h1 class="hero-enter hero-delay-2">
            BRING US
            <span>THE ODD ONES.</span>
          </h1>

          <p class="hero-kicker hero-enter hero-delay-3">
            Show us the job that made you look twice.
          </p>

          <p class="hero-definition hero-enter hero-delay-4">
            Vector X Volt builds unusual sign components for sign shops.
          </p>

          <p class="hero-text hero-enter hero-delay-5">
            We're developing new ways to make intricate parts, unusual
            geometry, one-offs, short runs, and the things that don't fit
            neatly into a standard production method.
          </p>

          <div class="hero-actions hero-enter hero-delay-6">
            <a
              class="button primary"
              href={`mailto:${email}?subject=Take%20a%20look%20at%20this`}
            >
              Send Us a Drawing
            </a>

            <a class="text-link" href="#interesting">
              See what we mean ↓
            </a>
          </div>

        </div>


        <!-- Temporary specimen until photography replaces it -->

        <div class="specimen hero-specimen">

          <div class="specimen-header">
            <span>TEST ARTICLE</span>
            <span>P001</span>
          </div>

          <div class="specimen-object">

            <div class="letter-r">R</div>

            <div class="dimension dim-top">
              <span></span>
              CURRENT DEVELOPMENT
              <span></span>
            </div>

            <div class="dimension dim-side">
              SPECIALTY FABRICATION
            </div>

          </div>

          <div class="specimen-footer">
            <span>VECTOR X VOLT / HOUSTON</span>
            <span>01</span>
          </div>

        </div>

      </section>


